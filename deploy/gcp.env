# Google Cloud settings for automatic deploys from GitHub. None of these are secrets.
# GCP_PROJECT, GCP_PROJECT_NUMBER and SITE_HOST are filled in after the first deploy (gcp-deploy.sh prints them).
GITHUB_REPO=tomvoo/ftc-film-room
GCP_PROJECT=
GCP_PROJECT_NUMBER=
ZONE=us-central1-a
VM=film-room
SITE_HOST=
